# Variables de entorno del frontend (todas opcionales en este sprint).
# Copia este archivo a `.env` si quieres personalizarlas (no se versiona `.env`).

# Puerto donde escucha el servidor Next.js dentro del contenedor.
PORT=3000

# Host al que se enlaza el servidor (0.0.0.0 para aceptar peticiones externas).
HOSTNAME=0.0.0.0

# Desactiva la telemetría de Next.js (recomendado en producción).
NEXT_TELEMETRY_DISABLED=1

# NODE_ENV se fija a production dentro de la imagen Docker; no es necesario definirlo aquí.
